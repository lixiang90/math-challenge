# ============================================================
#  Math Challenge — P2 环境变量模板（提交到仓库，供参考）
#  复制为 .env.local 并填写真实值：cp .env.example .env.local
# ============================================================

# ---------- Supabase（P2 真实数据库 + 鉴权后端）----------
# 获取位置：Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# service_role 仅用于服务端（验证回调写库、管理任务等），
# 切勿以 NEXT_PUBLIC_ 前缀暴露到浏览器。
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret

# 首位站点管理员：GitHub 登录名（小写、逗号分隔）。对应用户首次 OAuth 登录后，
# 由服务端（service_role）自动写入 site_admins。之后权限完全由表管理，此变量仅冷启动用。
# 注意：这是「被显式授权的人」，不是「拥有某个 GitHub 名就有权限」——@math-challenge 本身不持有任何权限。
INITIAL_ADMIN_LOGINS=lixiang90

# ---------- GitHub OAuth ----------
# 在 Supabase 中走 GitHub 登录时，以下两项需同步填到：
#   Supabase Dashboard → Authentication → Providers → GitHub
# 并在 GitHub 侧把「Authorization callback URL」设为：
#   https://<YOUR-PROJECT>.supabase.co/auth/v1/callback
# 获取位置：GitHub → Settings → Developer settings → OAuth Apps → New OAuth App
GITHUB_CLIENT_ID=your-github-oauth-app-client-id
GITHUB_CLIENT_SECRET=your-github-oauth-app-client-secret

# ---------- 站点地址（可选，用于回调/邮件链接拼接）----------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------- Lean verifier（P3 在线提交）----------
# 承载 verify-website-submission.yml 的私有仓库。本项目使用官方
# lean-eval-submissions 代码的私有镜像，避免 signed payload URL 暴露。
VERIFIER_REPO=lixiang90/math-challenge-eval
# 能对上述单一仓库触发 Actions workflow_dispatch 的 fine-grained PAT。
VERIFIER_GITHUB_TOKEN=github_pat_your_actions_write_token
VERIFIER_REF=main
VERIFIER_WORKFLOW=verify-website-submission.yml
# 与 verifier 仓库 GitHub Actions secret 同值；建议至少 32 随机字节。
VERIFIER_CALLBACK_SECRET=replace-with-a-long-random-secret
VERIFIER_COOLDOWN_SECONDS=600
VERIFIER_DAILY_QUOTA=20
